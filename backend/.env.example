# ============================================================
# Entorno: API Cordalia (Backend - Express + PostgreSQL)
# Copiar este archivo como .env y completar los valores.
# NUNCA subir el .env real: solo este ejemplo (sin secretos).
#
# Este archivo documenta EXACTAMENTE las variables que el backend
# lee (backend/src). Si una variable no aparece aqui, el backend no
# la usa.
# ============================================================

# ------------------------------------------------------------
# Servidor
# ------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------
# Base de datos PostgreSQL (Supabase o Postgres)
# ------------------------------------------------------------
# URL completa de conexion (obligatoria).
DATABASE_URL=postgresql://turismo_user:tu_password@localhost:5432/turismo_db
# 'true' en produccion cuando el proveedor (Supabase/Railway) lo exige.
DB_SSL=false

# ------------------------------------------------------------
# JWT
# ------------------------------------------------------------
# SECRETO - obligatorio. Clave aleatoria larga en produccion.
JWT_SECRET=una_clave_segura_larga_y_aleatoria
JWT_EXPIRES_IN=2h

# ------------------------------------------------------------
# Rate limiting (limites por ventana; todos configurables)
# ------------------------------------------------------------
# El almacen es EN MEMORIA: el limite es exacto con UNA sola instancia
# del backend. Con varias instancias se multiplica por instancia; en ese
# caso usa un store compartido (Redis/PostgreSQL).
#
# Login y cambio de contrasena: por IP/usuario cada 15 minutos.
AUTH_RATE_LIMIT_MAX=30
# Registro publico: por IP cada hora.
REGISTER_RATE_LIMIT_MAX=20
# Verificacion de Google: por IP cada 15 minutos.
GOOGLE_RATE_LIMIT_MAX=20
# Recuperacion/restablecimiento de contrasena: por IP cada hora.
PASSWORD_RESET_RATE_LIMIT_MAX=10
# Escritura de negocios: por usuario cada hora.
BUSINESS_WRITE_RATE_LIMIT_MAX=60
# Resenas: por usuario cada hora.
REVIEW_RATE_LIMIT_MAX=20
# Busquedas/listados: por usuario o IP cada minuto.
SEARCH_RATE_LIMIT_MAX=120
# Backstop general de toda la API: por IP cada 15 minutos.
GLOBAL_RATE_LIMIT_MAX=5000

# ------------------------------------------------------------
# URLs publicas (CORS, redirecciones y webhook)
# ------------------------------------------------------------
# Frontend: dominio publico de Vercel. Se usa en CORS y para armar
# los enlaces de retorno del proveedor de pagos y de recuperacion
# de contrasena.
FRONTEND_URL=http://localhost:5173
# Backend: URL publica de Railway. Se usa en CORS y como base de la
# URL de la webhook del proveedor de pagos.
BACKEND_URL=http://localhost:3000
# Alternativa a BACKEND_URL (si solo se define una, se usa esta).
APP_URL=http://localhost:3000

# ------------------------------------------------------------
# Pagos COMERCIALES (suscripciones mensuales de los vendedores)
# ------------------------------------------------------------
# IMPORTANTE: los planes TURISTICOS no tienen pagos (la inscripcion
# es gratuita). Mercado Pago se usa SOLO para el plan comercial
# mensual del vendedor.
#
# Proveedor de pagos:
#   'mock'        -> sandbox: el backend aprueba el pago en servidor.
#                    NO mueve dinero real. Valor por defecto.
#   'mercadopago' -> cobros reales (requiere credenciales + webhook).
PAYMENT_PROVIDER=mock
# SECRETO: completar solo en el entorno real. Nunca subir valores reales.
MERCADOPAGO_ACCESS_TOKEN=
# SECRETO: firma x-signature de la webhook. Si falta, la webhook falla cerrada.
MERCADOPAGO_WEBHOOK_SECRET=


# ------------------------------------------------------------
# Envio de correos (recuperacion de contrasena)
# ------------------------------------------------------------
# MAIL_PROVIDER:
#   'log'  -> escribe el correo en el log. SOLO desarrollo: en
#             produccion responde 503 (no finge el envio).
#   'http' -> POST a un endpoint HTTP de correo (Mailgun/Resend/
#             SendGrid o un relay propio).
MAIL_PROVIDER=log
MAIL_API_URL=
MAIL_API_KEY=
MAIL_FROM=Cordalia <no-reply@cordalia.app>

# ------------------------------------------------------------
# Google OAuth / OpenID Connect
# ------------------------------------------------------------
# Crear credenciales en:
#   https://console.cloud.google.com/apis/credentials
# 1. Crear un proyecto -> APIs y servicios -> Pantalla de consentimiento
# 2. Crear "ID de cliente de OAuth" -> aplicacion web
#   - Origen de JavaScript autorizado: http://localhost:5173
#     (en produccion: https://cordalia.vercel.app)
#   - El flujo usado (boton oficial + ID token) NO requiere URI de
#     redireccion: no agregar URIs ficticias.
# 3. GOOGLE_CLIENT_ID (NO es secreto; tambien se usa en el frontend
#    como VITE_GOOGLE_CLIENT_ID: deben ser EXACTAMENTE el mismo)
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
