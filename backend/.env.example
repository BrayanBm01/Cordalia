# ============================================================
# Entorno: API Turismo - Explora Turismo
# Copiar este archivo como .env y completar los valores
# ============================================================

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL
DB_USER=turismo_user
DB_HOST=localhost
DB_PASSWORD=tu_password
DB_PORT=5432
DB_NAME=turismo_db

# JWT
# SECRETO - obligatorio. Usar una clave aleatoria larga en produccion.
JWT_SECRET=una_clave_segura_larga_y_aleatoria
JWT_EXPIRES_IN=2h

# Frontend / Backend (para CORS)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# ============================================================
# Google OAuth / OpenID Connect
# ============================================================
# Crear credenciales en:
#   https://console.cloud.google.com/apis/credentials
# 1. Crear un proyecto -> APIs y servicios -> Pantalla de consentimiento
# 2. Crear "ID de cliente de OAuth" -> aplicacion web
#   - Origen de JavaScript autorizado: http://localhost:5173
#   - URI de redireccion autorizada: http://localhost:5173
# 3. GOOGLE_CLIENT_ID (NO es secreto; tambien se usa en el frontend como VITE_GOOGLE_CLIENT_ID)
# 4. GOOGLE_CLIENT_SECRET (SOLO backend - no exponer)
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
